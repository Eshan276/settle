# Generated for you by `pnpm deploy:testnet`. Copy to .env to configure manually.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
SETTLE_CONTRACT_ID=pay.<your-root>.testnet
DEFAULT_TOKEN_ID=susd.<your-root>.testnet          # mainnet: 17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1 (USDC)
RELAYER_ACCOUNT_ID=<your-root>.testnet              # pays gas, creates user accounts, invoice operator, Intents settlement account
RELAYER_PRIVATE_KEY=ed25519:...
AGENT_ACCOUNT_ID=agent.<your-root>.testnet          # AI AP agent: function-call key for agent_pay only
AGENT_PRIVATE_KEY=ed25519:...
INTENTS_MODE=simulated                              # "live" on mainnet (1Click API)
# ONECLICK_JWT=...                                  # avoids the 0.25% unauthenticated 1Click fee
PUBLIC_WEB_URL=http://localhost:3000
PORT=4000
# ANTHROPIC_API_KEY=sk-ant-...                      # Claude bill reading (PDF/image/text). Heuristic text parser otherwise.
# ANTHROPIC_MODEL=claude-opus-5-5
# RESEND_API_KEY=...                                # real email delivery for payouts (otherwise logged to console)
# ACCOUNTS_PER_IP_PER_HOUR=10                       # sponsored account creations per IP
